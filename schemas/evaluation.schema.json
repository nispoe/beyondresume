{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MatchEvaluation",
  "type": "object",
  "required": [
    "overallRecommendation",
    "confidence",
    "summary",
    "strengths",
    "risks",
    "openQuestions",
    "scores"
  ],
  "properties": {
    "overallRecommendation": {
      "type": "string",
      "enum": ["strong_match", "possible_match", "weak_match", "not_a_match"]
    },
    "confidence": { "type": "number" },
    "summary": { "type": "string" },
    "strengths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "openQuestions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scores": {
      "type": "object",
      "required": ["skills", "experience", "culture", "motivation", "constraints"],
      "properties": {
        "skills": { "type": "number" },
        "experience": { "type": "number" },
        "culture": { "type": "number" },
        "motivation": { "type": "number" },
        "constraints": { "type": "number" }
      }
    }
  }
}
